SERVER_PORT=8080
TIME_ZONE=Asia/Dhaka
LOG_LEVEL_API=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zip_url_db
DB_SSLMODE=disable
SLOW_SQL_LOG_THRESHOLD=200

# SECURITY CONFIGURATION
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com,https://www.example.com

# PROJECT ROOT BASE URL (In production change it with your original site url)
ZIP_URL_BASE_URL='http://localhost:8080'

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_ALGORITHM=RS512
JWT_SIGNING_KEY=''
JWT_VERIFYING_KEY=''
JWT_ISSUER=zip_url
JWT_AUDIENCE=zip_url
JWT_AUTH_HEADER_TYPE=JWT
# Token Expiry (in seconds)
ACCESS_TOKEN_EXPIRY=3600     # 1 hour
REFRESH_TOKEN_EXPIRY=86400   # 24 hours (1 day)

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis DSN format: redis://[user:password@]host:port[/db]
REDIS_DSN=redis://localhost:6379/0
